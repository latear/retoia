{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "retoia": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://gateway.example/v1"
      },
      "models": {
        "model-a": {
          "name": "Model A"
        },
        "model-c": {
          "name": "Model C"
        },
        "auto": {
          "name": "Auto"
        }
      }
    }
  },
  "agent": {
    "Retoia-Orchestrator": {
      "mode": "primary",
      "description": "Lead agent. Plans and delegates; does not write code.",
      "model": "retoia/model-a"
    },
    "cs-recon": {
      "mode": "subagent",
      "description": "Recon, enumeration and analysis (read-only).",
      "model": "retoia/model-b"
    },
    "cs-reviewer": {
      "mode": "subagent",
      "description": "Reviews and hardens output.",
      "model": "retoia/model-c"
    },
    "gentle-orchestrator": {
      "mode": "primary",
      "description": "Unrelated gentle-ai orchestrator agent, not managed by retoia-models.",
      "model": null
    }
  }
}
